apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ .Name }}
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "{{ .SyncWave }}"
spec:
  project: default
{{- if .IsLocalChart }}
  source:
    repoURL: '{{ .RepoURL }}'
    targetRevision: {{ .TargetRevision }}
    path: {{ .BundleDir }}
{{- else }}
  sources:
    - repoURL: {{ .Repository }}
      chart: {{ .Chart }}
      targetRevision: {{ .Version }}
      helm:
        valueFiles:
          - $values/{{ .BundleDir }}/values.yaml
    - repoURL: '{{ .RepoURL }}'
      targetRevision: {{ .TargetRevision }}
      ref: values
{{- end }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ .Namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
      # ServerSideApply: required for charts whose CRDs exceed kubectl's
      # 262144-byte client-side annotation cap (e.g., kube-prometheus-stack,
      # kai-scheduler). Without this, Argo's sync retries forever with
      # "metadata.annotations: Too long". server-side apply uses the
      # apiserver's structured-merge path and has no such cap.
      - ServerSideApply=true
